from machine import Pin, UART
import utime as time
from pymavminimal import MAVLink

# --- Hardware Setup ---
pin_a = Pin(2, Pin.IN, Pin.PULL_UP)
pin_b = Pin(3, Pin.IN, Pin.PULL_UP)
uart = UART(1, baudrate=921600, tx=Pin(4), rx=Pin(5))

# --- Encoder Variables ---
counter = 0
ppr = 500
counts_per_rev = ppr * 2 

def encoder_handler(pin):
    global counter
    if pin_a.value() ^ pin_b.value():
        counter += 1
    else:
        counter -= 1

pin_a.irq(trigger=Pin.IRQ_RISING | Pin.IRQ_FALLING, handler=encoder_handler)

# --- MAVLink Setup ---
mav = MAVLink(1, 100)
last_heartbeat = 0
last_data = 0
last_print = 0
active_wing = "PORT (Left)"

print("--- Pico Flap Testbed: System Ready ---")

while True:
    current_time = time.ticks_ms()

    # --- 1. Listen for STATUSTEXT Commands (Non-Blocking) ---
    if uart.any():
        try:
            raw_rx = uart.read()
            # We look for the raw ASCII strings within the MAVLink frame
            if b"ZERO" in raw_rx:
                counter = 0
                print(">> RECEIVED: ZERO COMMAND")
            elif b"TOGGLE" in raw_rx:
                active_wing = "STARBOARD (Right)" if active_wing == "PORT (Left)" else "PORT (Left)"
                print(">> RECEIVED: TOGGLE WING ->", active_wing)
        except Exception as e:
            # This prevents the script from stopping if it hears 'noise'
            pass

    # --- 2. Heartbeat (1Hz) ---
    if time.ticks_diff(current_time, last_heartbeat) >= 1000:
        msg = mav.heartbeat_encode(6, 8, 0, 0, 0)
        uart.write(msg.pack(mav))
        last_heartbeat = current_time

    # --- 3. Process and Send Angle Data (50Hz) ---
    if time.ticks_diff(current_time, last_data) >= 20:
        angle = (counter / counts_per_rev) * 360.0
        msg = mav.named_value_float_encode(time.ticks_ms(), "FlapAngle", angle)
        uart.write(msg.pack(mav))
        last_data = current_time

    # --- 4. Terminal Output (2Hz) ---
    if time.ticks_diff(current_time, last_print) >= 500:
        print("Wing: {} | Angle: {:.2f}°".format(active_wing, angle))
        last_print = current_time
